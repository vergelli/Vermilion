<GuiXml>
  <Controls>

    <TopLevelControl name="VermilionSettingsPanel"
                     hidden="true"
                     clampedToScreen="true"
                     movable="true"
                     mouseEnabled="true">

      <Dimensions x="600" y="300"/>

      <OnMoveStop>Vermilion.Settings.on_move_stop()</OnMoveStop>

      <Controls>

        <Backdrop name="$(parent)Bg">
          <AnchorFill/>
          <Edge file="EsoUI/Art/Tooltips/UI-Border.dds"
                edgeFileWidth="128" edgeFileHeight="16" edgeSize="6"/>
          <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds"/>
          <Insets left="6" top="6" right="-6" bottom="-6"/>
        </Backdrop>

        <Texture name="$(parent)BrandLogo" textureFile="Vermilion/assets/logo.dds">
          <Anchor point="TOPLEFT" offsetX="12" offsetY="8"/>
          <Dimensions x="24" y="24"/>
        </Texture>

        <Label name="$(parent)WindowTitle"
               font="ZoFontWindowTitle"
               horizontalAlignment="LEFT"
               verticalAlignment="CENTER">
          <Anchor point="TOPLEFT" offsetX="42" offsetY="10"/>
          <Dimensions y="18"/>
        </Label>

        <Label name="$(parent)VersionLabel"
               font="ZoFontGameSmall"
               horizontalAlignment="RIGHT"
               verticalAlignment="CENTER">
          <Anchor point="TOPRIGHT" offsetX="-30" offsetY="12"/>
          <Dimensions x="60" y="14"/>
        </Label>

        <Button name="$(parent)CloseBtn" mouseEnabled="true"
                mouseOverBlendMode="ADD" inherits="ZO_ButtonBehaviorClickSound">
          <Anchor point="TOPRIGHT" offsetX="-8" offsetY="8"/>
          <Dimensions x="16" y="16"/>
          <OnClicked>Vermilion.Settings.toggle()</OnClicked>
        </Button>

        <Button name="$(parent)DevBtn" font="ZoFontGameSmall" hidden="true"
                inherits="ZO_DefaultButton">
          <Anchor point="TOPRIGHT" offsetX="-96" offsetY="8"/>
          <Dimensions x="44" y="20"/>
          <OnClicked>Vermilion.DevTools.toggle()</OnClicked>
        </Button>







        <Label name="$(parent)SecGraph" font="ZoFontGameSmall"
               horizontalAlignment="LEFT" verticalAlignment="CENTER">
          <Anchor point="TOPLEFT" offsetX="14" offsetY="46"/>
          <Dimensions x="200" y="12"/>
        </Label>
        <Texture name="$(parent)SepGraph">
          <Anchor point="TOPLEFT" offsetX="14" offsetY="60"/>
          <Dimensions x="272" y="1"/>
        </Texture>



        <Label name="$(parent)VPAlphaTitle"
               font="ZoFontGameSmall"
               horizontalAlignment="LEFT"
               verticalAlignment="CENTER">
          <Anchor point="TOPLEFT" offsetX="14" offsetY="68"/>
          <Dimensions x="160" y="12"/>
        </Label>
        <Label name="$(parent)VPAlphaLabel"
               font="ZoFontGameSmall"
               horizontalAlignment="RIGHT"
               verticalAlignment="CENTER">
          <Anchor point="TOPLEFT" offsetX="206" offsetY="68"/>
          <Dimensions x="80" y="12"/>
        </Label>
        <Control name="$(parent)SliderTrackVPAlpha" mouseEnabled="true">
          <Anchor point="TOPLEFT" offsetX="14" offsetY="83"/>
          <Dimensions x="272" y="14"/>
        </Control>

        <Label name="$(parent)CritThreshTitle"
               font="ZoFontGameSmall"
               horizontalAlignment="LEFT"
               verticalAlignment="CENTER">
          <Anchor point="TOPLEFT" offsetX="14" offsetY="106"/>
          <Dimensions x="160" y="12"/>
        </Label>
        <Label name="$(parent)CritThreshLabel"
               font="ZoFontGameSmall"
               horizontalAlignment="RIGHT"
               verticalAlignment="CENTER">
          <Anchor point="TOPLEFT" offsetX="206" offsetY="106"/>
          <Dimensions x="80" y="12"/>
        </Label>
        <Control name="$(parent)SliderTrackCritThresh" mouseEnabled="true">
          <Anchor point="TOPLEFT" offsetX="14" offsetY="121"/>
          <Dimensions x="272" y="14"/>
        </Control>

        <Button name="$(parent)SampleBtn" mouseEnabled="true" font="ZoFontGameSmall" inherits="ZO_DefaultButton">
          <Anchor point="TOPLEFT" offsetX="14" offsetY="146"/>
          <Dimensions x="272" y="24"/>
          <OnClicked>Vermilion.Settings.on_sample_click()</OnClicked>
        </Button>

        <Label name="$(parent)SecRecording" font="ZoFontGameSmall"
               horizontalAlignment="LEFT" verticalAlignment="CENTER">
          <Anchor point="TOPLEFT" offsetX="14" offsetY="186"/>
          <Dimensions x="200" y="12"/>
        </Label>
        <Texture name="$(parent)SepRecording">
          <Anchor point="TOPLEFT" offsetX="14" offsetY="200"/>
          <Dimensions x="272" y="1"/>
        </Texture>

        <Label name="$(parent)RecordingNote" font="ZoFontGameSmall"
               horizontalAlignment="LEFT" verticalAlignment="TOP" wrapMode="ELLIPSIS">
          <Anchor point="TOPLEFT" offsetX="14" offsetY="208"/>
          <Dimensions x="272" y="50"/>
        </Label>

        <Label name="$(parent)SecGeneral" font="ZoFontGameSmall"
               horizontalAlignment="LEFT" verticalAlignment="CENTER">
          <Anchor point="TOPLEFT" offsetX="314" offsetY="46"/>
          <Dimensions x="200" y="12"/>
        </Label>
        <Texture name="$(parent)SepGeneral">
          <Anchor point="TOPLEFT" offsetX="314" offsetY="60"/>
          <Dimensions x="272" y="1"/>
        </Texture>

        <Button name="$(parent)UnknownBtn" mouseEnabled="true"
                mouseOverBlendMode="ADD" inherits="ZO_ButtonBehaviorClickSound">
          <Anchor point="TOPLEFT" offsetX="314" offsetY="68"/>
          <Dimensions x="28" y="28"/>
          <Textures normal="EsoUI/Art/Dye/dyes_toolIcon_fill_up.dds"
                    pressed="EsoUI/Art/Dye/dyes_toolIcon_fill_down.dds"
                    mouseOver="EsoUI/Art/Dye/dyes_toolIcon_fill_over.dds"/>
          <OnClicked>Vermilion.Settings.on_unknown_click()</OnClicked>
        </Button>

        <Label name="$(parent)UnknownLabel"
               font="ZoFontGameSmall"
               horizontalAlignment="LEFT"
               verticalAlignment="CENTER"
               mouseEnabled="true">
          <Anchor point="LEFT" relativeTo="$(parent)UnknownBtn" relativePoint="RIGHT" offsetX="10" offsetY="0"/>
          <Dimensions x="220" y="28"/>
          <OnMouseUp>Vermilion.Settings.on_unknown_click()</OnMouseUp>
        </Label>

        <Button name="$(parent)LogoBtn"
                mouseEnabled="true"
                font="ZoFontGameSmall"
                inherits="ZO_DefaultButton">
          <Anchor point="TOPLEFT" offsetX="314" offsetY="102"/>
          <Dimensions x="272" y="22"/>
          <OnClicked>Vermilion.Settings.on_logo_click()</OnClicked>
        </Button>

        <Button name="$(parent)SoundsBtn"
                mouseEnabled="true"
                font="ZoFontGameSmall"
                inherits="ZO_DefaultButton">
          <Anchor point="TOPLEFT" offsetX="314" offsetY="130"/>
          <Dimensions x="272" y="22"/>
          <OnClicked>Vermilion.Settings.on_sounds_click()</OnClicked>
        </Button>

        <Button name="$(parent)LightBtn"
                mouseEnabled="true"
                font="ZoFontGameSmall"
                inherits="ZO_DefaultButton">
          <Anchor point="TOPLEFT" offsetX="314" offsetY="158"/>
          <Dimensions x="272" y="22"/>
          <OnClicked>Vermilion.Settings.on_light_click()</OnClicked>
        </Button>

        <Button name="$(parent)KillsBtn"
                mouseEnabled="true"
                font="ZoFontGameSmall"
                inherits="ZO_DefaultButton">
          <Anchor point="TOPLEFT" offsetX="314" offsetY="186"/>
          <Dimensions x="134" y="22"/>
          <OnClicked>Vermilion.Settings.on_kills_click()</OnClicked>
        </Button>

        <Button name="$(parent)AvgBtn"
                mouseEnabled="true"
                font="ZoFontGameSmall"
                inherits="ZO_DefaultButton">
          <Anchor point="TOPLEFT" offsetX="452" offsetY="186"/>
          <Dimensions x="134" y="22"/>
          <OnClicked>Vermilion.Settings.on_avg_click()</OnClicked>
        </Button>

        <Label name="$(parent)LightAlphaTitle"
               font="ZoFontGameSmall"
               horizontalAlignment="LEFT"
               verticalAlignment="CENTER">
          <Anchor point="TOPLEFT" offsetX="314" offsetY="214"/>
          <Dimensions x="160" y="12"/>
        </Label>
        <Label name="$(parent)LightAlphaLabel"
               font="ZoFontGameSmall"
               horizontalAlignment="RIGHT"
               verticalAlignment="CENTER">
          <Anchor point="TOPLEFT" offsetX="506" offsetY="214"/>
          <Dimensions x="80" y="12"/>
        </Label>
        <Control name="$(parent)SliderTrackLightAlpha" mouseEnabled="true">
          <Anchor point="TOPLEFT" offsetX="314" offsetY="229"/>
          <Dimensions x="272" y="14"/>
        </Control>

        <Texture name="$(parent)SepColumns">
          <Anchor point="TOPLEFT" offsetX="300" offsetY="46"/>
          <Dimensions x="1" y="214"/>
        </Texture>

        <Button name="$(parent)ResetBtn"
                mouseEnabled="true"
                font="ZoFontGameSmall"
                inherits="ZO_DefaultButton">
          <Anchor point="BOTTOMLEFT" offsetX="14" offsetY="-8"/>
          <Dimensions x="272" y="22"/>
          <OnClicked>Vermilion.Settings.on_reset_click()</OnClicked>
        </Button>

      </Controls>
    </TopLevelControl>
  </Controls>
</GuiXml>
